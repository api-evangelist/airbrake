{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airbrake REST Activities API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List project activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airbrake.io/api/v4/projects/:project_id/activities",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List project activities"
        },
        {
          "info": {
            "name": "Project statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airbrake.io/api/v4/projects/:project_id/stats",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Project statistics"
        }
      ]
    }
  ],
  "bundled": true
}
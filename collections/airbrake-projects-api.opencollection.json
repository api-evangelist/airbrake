{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airbrake REST Activities Projects API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airbrake.io/api/v4/projects"
          },
          "docs": "List projects"
        },
        {
          "info": {
            "name": "Show project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airbrake.io/api/v4/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show project"
        }
      ]
    }
  ],
  "bundled": true
}